# Public landing/canonical URL. В production: https://shidao.ru
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Рабочий app/Auth callback URL. В production: https://v2.shidao.ru
# Имеет приоритет над NEXT_PUBLIC_SITE_URL для auth redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (self-hosted или cloud)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# RouterAI (только server runtime; никогда не использовать префикс NEXT_PUBLIC_)
# Ключ обязателен только для AI-функций. Ручной Course Builder работает без него.
ROUTERAI_API_KEY=replace-with-routerai-api-key

# Optional RouterAI config (ниже указаны текущие defaults приложения)
ROUTERAI_MODEL=qwen/qwen3-30b-a3b-instruct-2507
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_TIMEOUT_MS=300000

# App-session cookie secret (минимум 32 символа, высокий entropy)
APP_SESSION_SECRET=replace-with-strong-random-secret

# Глобальная инвалидизация app-session через bump версии
APP_SESSION_VERSION=1

# Время жизни app-session в часах (по умолчанию 48). Короче = меньше окно
# для скомпрометированной cookie, но чаще релогин.
APP_SESSION_TTL_HOURS=48

# Optional: режим автоподтверждения email (обычно false в production)
ENABLE_EMAIL_AUTOCONFIRM=false

# SMTP/email-auth для self-hosted Supabase настраивается в окружении Supabase (GoTrue),
# а не в Next.js env этого приложения. Практический runbook:
# docs/email-auth-selfhosted-supabase.md
